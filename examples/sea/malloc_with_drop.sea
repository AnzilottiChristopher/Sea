// test_with_drop.sea
class Buffer {
    pub int *data;

    pub init(int size) {
        this.data = malloc(sizeof(int) * size);
    }

    pub drop() {
        free(this.data);
    }

    pub write(int value) {
        this.data[0] = value;
    }
}

int main() {
    Buffer buf = new Buffer(10);
    buf.write(42);
}
